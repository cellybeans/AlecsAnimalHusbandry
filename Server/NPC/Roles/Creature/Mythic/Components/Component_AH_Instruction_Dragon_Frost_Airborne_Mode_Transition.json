{
  "$Comment": "Native walk/fly controller transition for the tamed Frost Dragon's airborne combat mode.",
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "AnimalHusbandry.Instruction.DragonFrostAirborneModeTransition",
  "Content": {
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "Neutralize legacy Tamework flying-companion mode before native controller handling begins.",
        "Continue": true,
        "Sensor": {
          "Type": "Any",
          "Once": true
        },
        "Actions": [
          {
            "Type": "TameworkSetFlyingCompanionMode",
            "Mode": "Follow"
          }
        ]
      },
      {
        "$Comment": "Consume a Frost Dragon airborne-mode hook without changing the active companion order.",
        "Continue": true,
        "Sensor": {
          "Type": "TameworkHook",
          "HookId": "AnimalHusbandry.Command.ToggleFrostDragonAirborneMode",
          "Consume": true
        },
        "Instructions": [
          {
            "Sensor": {
              "Type": "Flag",
              "Name": "AirborneMode"
            },
            "Actions": [
              {
                "Type": "SetFlag",
                "Name": "AirborneMode",
                "SetTo": false
              }
            ]
          },
          {
            "Sensor": {
              "Type": "Flag",
              "Name": "AirborneMode",
              "Set": false
            },
            "Actions": [
              {
                "Type": "SetFlag",
                "Name": "AirborneMode",
                "SetTo": true
              }
            ]
          }
        ]
      },
      {
        "$Comment": "Airborne mode starts the native flight controller without changing the active order.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Flag",
              "Name": "AirborneMode"
            },
            {
              "Type": "MotionController",
              "MotionController": "Walk"
            }
          ]
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status"
          }
        ],
        "BodyMotion": {
          "Type": "TakeOff",
          "JumpSpeed": 4
        }
      },
      {
        "$Comment": "Grounded mode descends with the native landing ray without changing the active order.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Flag",
              "Name": "AirborneMode",
              "Set": false
            },
            {
              "Type": "MotionController",
              "MotionController": "Fly"
            }
          ]
        },
        "Instructions": [
          {
            "Sensor": {
              "Type": "AdjustPosition",
              "Offset": [
                0,
                1,
                0
              ],
              "Sensor": {
                "Type": "SearchRay",
                "Name": "LandingRay",
                "Range": 64,
                "Angle": 90,
                "Blocks": "StoneAndSoil"
              }
            },
            "BodyMotion": {
              "Type": "Land",
              "UsePathfinder": false,
              "SkipSteering": false,
              "SlowDownDistance": 5,
              "StopDistance": 0.5,
              "HeightDifference": [
                -3,
                2
              ],
              "GoalLenience": 3,
              "DesiredAltitudeWeight": 0
            }
          }
        ]
      },
      {
        "$Comment": "Clear the landing ray after touchdown.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Flag",
              "Name": "AirborneMode",
              "Set": false
            },
            {
              "Type": "MotionController",
              "MotionController": "Walk"
            }
          ]
        },
        "Actions": [
          {
            "Type": "ResetSearchRays"
          }
        ]
      }
    ]
  }
}
