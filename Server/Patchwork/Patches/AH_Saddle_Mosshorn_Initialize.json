{
  "Id": "AH_Saddle_Mosshorn_Initialize",
  "$Comment": "Patch any loaded Mosshorn model definitions to include saddles. TargetExists is evaluated per target.",
  "When": {
    "All": [
      {
        "TargetExists": true
      },
      {
        "Not": {
          "JsonPathExists": {
            "Source": {
              "Type": "Target"
            },
            "Path": "/RandomAttachmentSets"
          }
        }
      }
    ]
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-saddles-for-mosshorn-initialize-attachments",
      "Op": "Add",
      "Path": "/RandomAttachmentSets",
      "Value": {
        "AH_Saddle": {
          "None": {
            "Weight": 1
          },
          "Yes": {
            "Model": "NPC/Wildlife/Mosshorn/Models/Attachments/Saddle_Mosshorn.blockymodel",
            "Texture": "NPC/Wildlife/Moose/Models/Attachments/Saddle_Leather.png",
            "Weight": 0
          }
        }
      }
    }
  ],
  "Target": "Server/Models/Wildlife/Mosshorn.json"
}
