{
  "Id": "AH_Saddle_Camel",
  "$Comment": "Patch any loaded Camel model definitions to include saddle. TargetExists is evaluated per target.",
  "Target": "Server/Models/Livestock/Camel.json",
  "When": {
    "All": [
      {
        "TargetExists": true
      },
      {
        "JsonPathExists": {
          "Source": {
            "Type": "Target"
          },
          "Path": "/RandomAttachmentSets"
        }
      }
    ]
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-saddles-for-camel",
      "Op": "Merge",
      "Path": "/RandomAttachmentSets",
      "Value": {
        "AH_Saddle": {
          "None": {
            "Weight": 1
          },
          "Yes": {
            "Model": "NPC/Livestock/Camel/Models/Attachments/Saddle_Camel.blockymodel",
            "Texture": "NPC/Wildlife/Moose/Models/Attachments/Saddle_Leather.png",
            "Weight": 0
          }
        }
      }
    }
  ]
}
