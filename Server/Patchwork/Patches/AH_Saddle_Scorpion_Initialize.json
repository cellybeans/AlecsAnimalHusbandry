{
  "Id": "AH_Saddle_Scorpion_Initialize",
  "$Comment": "Patch loaded Lobster and Scorpion model definitions with their shared pelvis-mounted saddle. TargetExists is evaluated per target.",
  "When": {
    "All": [
      {
        "TargetExists": true
      },
      {
        "Not": {
          "JsonPathExists": {
            "Source": {
              "Type": "Target"
            },
            "Path": "/RandomAttachmentSets"
          }
        }
      }
    ]
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-saddles-for-scorpion-initialize-attachments",
      "Op": "Add",
      "Path": "/RandomAttachmentSets",
      "Value": {
        "AH_Saddle": {
          "None": {
            "Weight": 1
          },
          "Yes": {
            "Model": "NPC/Swimming_Beast/Lobster/Models/Attachments/Saddle_Lobster.blockymodel",
            "Texture": "NPC/Wildlife/Moose/Models/Attachments/Saddle_Leather.png",
            "Weight": 0
          }
        }
      }
    }
  ],
  "Target": "Server/Models/Beast/Scorpion.json"
}
