{
  "Id": "AH_Saddle_Mosshorn_Plain",
  "$Comment": "Patch any loaded Mosshorn Plain model definitions to include saddles. TargetExists is evaluated per target.",
  "When": {
    "All": [
      {
        "TargetExists": true
      },
      {
        "JsonPathExists": {
          "Source": {
            "Type": "Target"
          },
          "Path": "/RandomAttachmentSets"
        }
      }
    ]
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-saddles-for-mosshorn-plain",
      "Op": "Merge",
      "Path": "/RandomAttachmentSets",
      "Value": {
        "AH_Saddle": {
          "None": {
            "Weight": 1
          },
          "Yes": {
            "Model": "NPC/Wildlife/Mosshorn/Models/Attachments/Saddle_Mosshorn.blockymodel",
            "Texture": "NPC/Wildlife/Moose/Models/Attachments/Saddle_Leather.png",
            "Weight": 0
          }
        }
      }
    }
  ],
  "Target": "Server/Models/Wildlife/Mosshorn_Plain.json"
}
